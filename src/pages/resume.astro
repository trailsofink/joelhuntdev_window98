---
import Desktop from '../layouts/Desktop.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { resume } from '../data/resume';
import '../components/content/content.css';

const { recent, earlier } = resume;
const roleCount = 1 + earlier.roles.length;
const linkedin = profile.links.find((l) => l.id === 'linkedin')!;
const github = profile.links.find((l) => l.id === 'github')!;
---

<Desktop
  title="Resume"
  description="Joel Hunt's resume: full-stack developer and UX engineer, most recently Director of Product Engineering at Bulqit. Summary, technical skills and six roles since 2020, with a PDF download."
  app="resume"
>
  <Window
    app="resume"
    menu={['File', 'Edit', 'View', 'Insert', 'Format', 'Help']}
    status={['For Help, press F1', `${roleCount} roles`]}
  >
    <div class="doc-toolbar">
      <a class="btn" href={profile.resumePdf} download="Joel_Hunt_Resume.pdf">
        <Icon name="pdf" size={16} /> Download PDF
      </a>
      <span class="toolbar-note">PDF, 1 file</span>
    </div>
    <div class="doc doc-page resume sunken-panel">
      <header class="resume-head">
        <p class="resume-name">{profile.name}</p>
        <p class="resume-title">{profile.title}</p>
        <p class="doc-meta">
          {profile.location}{' · '}<a href={`mailto:${profile.email}`}>{profile.email}</a>{' · '}<a href={linkedin.href}>{linkedin.handle}</a>{' · '}<a href={github.href}>{github.handle}</a>
        </p>
      </header>

      <section aria-labelledby="r-summary">
        <h2 id="r-summary">Professional summary</h2>
        <p>{resume.summary}</p>
      </section>

      <section aria-labelledby="r-skills">
        <h2 id="r-skills">Technical skills</h2>
        <dl class="skills">
          {resume.skills.map(([group, list]) => (
            <div>
              <dt>{group}</dt>
              <dd>{list}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section aria-labelledby="r-recent">
        <h2 id="r-recent">Most recent role</h2>
        <article class="role">
          <h3>{recent.role}, <a href={`/experience/${recent.experience}`}>{recent.company}</a></h3>
          <p class="doc-meta">{recent.dates}</p>
          <p class="role-context">{recent.context}</p>
          <ul>
            {recent.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </article>
      </section>

      <section aria-labelledby="r-earlier">
        <h2 id="r-earlier">Earlier roles</h2>
        <article class="role">
          <h3>{earlier.heading}</h3>
          <p class="doc-meta">{earlier.dates}</p>
          <ul>
            {earlier.roles.map((r) => (
              <li><strong>{r.role}, <a href={`/experience/${r.experience}`}>{r.company}</a>:</strong> {r.text}</li>
            ))}
          </ul>
        </article>
      </section>
    </div>
  </Window>
</Desktop>

<style>
  .resume { padding-top: 20px; }
  .resume-name { font-size: var(--step-3); font-weight: 700; line-height: 1.1; margin: 0; }
  .resume-title { font-size: var(--step-1); margin: 0.2em 0 0.4em; }
  .resume h2 {
    border-bottom: 1px solid var(--button-shadow);
    padding-bottom: 0.2em;
    max-width: var(--measure);
  }
  .resume h3 { margin-bottom: 0.1em; }
  .role { margin-bottom: 1.25em; }
  .role-context { font-style: italic; color: var(--doc-muted); }
  .role li { margin-bottom: 0.5em; }
  .skills { margin: 0; max-width: var(--measure); }
  .skills div { margin-bottom: 0.4em; }
  .skills dt { font-weight: 700; display: inline; }
  .skills dt::after { content: ": "; }
  .skills dd { display: inline; margin: 0; }
  .toolbar-note { color: var(--text-color); }
</style>
