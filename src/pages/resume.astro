---
import { getCollection, render } from 'astro:content';
import Desktop from '../layouts/Desktop.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import { profile, skills, education } from '../data/profile';
import '../components/content/content.css';

const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(roles.map(async (r) => ({ role: r, ...(await render(r)) })));

// The resume's full summary. profile.summary is its first two sentences.
const summary = [
  profile.summary,
  'The redesign covered 45 routes in five weeks, built from the lead designer’s Figma system in React and Next.js, and along the way I built the company’s end-to-end test suite, CI quality gates, security fixes and performance work.',
  'A design background means the interfaces I build match the design system, meet WCAG 2.1 accessibility standards, and measurably change what users do.',
].join(' ');
const linkedin = profile.links.find((l) => l.id === 'linkedin')!;
const github = profile.links.find((l) => l.id === 'github')!;
---

<Desktop
  title="Resume"
  description="Joel Hunt's resume: full-stack developer and UX engineer, most recently Director of Product Engineering at Bulqit. Skills, six roles since 2020 and education, with a PDF download."
  app="resume"
>
  <Window
    app="resume"
    menu={['File', 'Edit', 'View', 'Insert', 'Format', 'Help']}
    status={['For Help, press F1', `${roles.length} roles`]}
  >
    <div class="doc-toolbar">
      <a class="btn" href={profile.resumePdf} download="Joel_Hunt_Resume.pdf">
        <Icon name="pdf" size={16} /> Download PDF
      </a>
      <span class="toolbar-note">PDF, 1 file</span>
    </div>
    <div class="doc doc-page resume sunken-panel">
      <header class="resume-head">
        <p class="resume-name">{profile.name}</p>
        <p class="resume-title">{profile.title}</p>
        <p class="doc-meta">
          {profile.location}{' · '}<a href={`mailto:${profile.email}`}>{profile.email}</a>{' · '}<a href={linkedin.href}>{linkedin.handle}</a>{' · '}<a href={github.href}>{github.handle}</a>
        </p>
      </header>

      <section aria-labelledby="r-summary">
        <h2 id="r-summary">Summary</h2>
        <p>{summary}</p>
      </section>

      <section aria-labelledby="r-skills">
        <h2 id="r-skills">Technical skills</h2>
        <dl class="skills">
          {Object.entries(skills).map(([group, list]) => (
            <div>
              <dt>{group}</dt>
              <dd>{list.join(', ')}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section aria-labelledby="r-experience">
        <h2 id="r-experience">Experience</h2>
        {rendered.map(({ role, Content }) => (
          <article class="role">
            <h3>{role.data.role}, <a href={`/experience/${role.id}`}>{role.data.company}</a></h3>
            <p class="doc-meta">{role.data.start} – {role.data.end} · {role.data.blurb}</p>
            <Content />
          </article>
        ))}
      </section>

      <section aria-labelledby="r-education">
        <h2 id="r-education">Education</h2>
        {education.map((e) => (
          <article class="role">
            <h3>{e.credential}, {e.school}</h3>
            <p class="doc-meta">{e.dates}</p>
            {e.note && <p>{e.note}</p>}
          </article>
        ))}
      </section>
    </div>
  </Window>
</Desktop>

<style>
  .resume { padding-top: 20px; }
  .resume-name { font-size: var(--step-3); font-weight: 700; line-height: 1.1; margin: 0; }
  .resume-title { font-size: var(--step-1); margin: 0.2em 0 0.4em; }
  .resume h2 {
    border-bottom: 1px solid var(--button-shadow);
    padding-bottom: 0.2em;
    max-width: var(--measure);
  }
  .resume h3 { margin-bottom: 0.1em; }
  .role { margin-bottom: 1.25em; }
  .skills { margin: 0; max-width: var(--measure); }
  .skills div { margin-bottom: 0.4em; }
  .skills dt { font-weight: 700; display: inline; }
  .skills dt::after { content: ": "; }
  .skills dd { display: inline; margin: 0; }
  .toolbar-note { color: var(--text-color); }
</style>
