---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Desktop from '../../layouts/Desktop.astro';
import Window from '../../components/Window.astro';
import Explorer from '../../components/Explorer.astro';
import { folders, type FolderId } from '../../components/content/folders';
import '../../components/content/content.css';

export const getStaticPaths = (async () => {
  const roles = await getCollection('experience');
  return roles.map((role) => ({ params: { slug: role.id }, props: { role } }));
}) satisfies GetStaticPaths;

interface Props { role: CollectionEntry<'experience'> }
const { role } = Astro.props;
const { Content } = await render(role);
const { company, start, end, blurb } = role.data;
const folder = (role.id in folders ? folders[role.id as FolderId] : null);
const projects = folder
  ? (await getCollection('projects', (p) => p.data.folder === folder.id)).sort((a, b) => a.data.order - b.data.order)
  : [];
---

<Desktop
  title={`${role.data.role}, ${company}`}
  description={`Joel Hunt as ${role.data.role} at ${company}, ${start} – ${end}. ${blurb}`}
  app="about"
>
  <Window app="about" title={`${company}.doc`} status={[`${start} – ${end}`]}>
    <Explorer path={`C:\\Joel Hunt\\Work Experience\\${company}.doc`} icon="wordpad-doc" nav>
      <article class="doc-page">
        <p class="doc-lede"><strong>{role.data.role}</strong>, {company}</p>
        <p class="doc-meta">{start} – {end} · {blurb}</p>
        <Content />

        {folder && (
          <section aria-labelledby="role-projects">
            <h2 id="role-projects">Case studies</h2>
            <ul>
              {projects.map((p) => (
                <li><a href={`/projects/${p.id}`}>{p.data.title}</a></li>
              ))}
            </ul>
            <p><a href={`/projects/${folder.id}`}>Open the {folder.name} project folder</a></p>
          </section>
        )}

        <p class="doc-meta"><a href="/experience">Back to Work Experience</a> · <a href="/resume">Full resume</a></p>
      </article>
    </Explorer>
  </Window>
</Desktop>
