---
// A Windows 98 Explorer view: toolbar and address bar, an optional folder tree
// on the left, and the folder's contents on the right.
//
// The contents are one of:
//   - files (`items`), with an optional details panel (`details` slot) that
//     sits to the right of them once the pane is wide enough;
//   - a document (the default slot), e.g. a case study or Credits.txt;
//   - both, for the home folder: the document fills the pane and the files
//     live in the tree, so the file list only shows when the tree doesn't
//     (narrow windows, or the tree toggled off).
//
// `nav` adds the Folders (hamburger), Back and Forward buttons and the tree.
// Pages with `nav` all render in the About Me window, so moving between them
// swaps that one window's contents (see src/scripts/explorer.ts).
//
// Phones get a vertical file list with 44px rows; wider panes (container
// queries, so they follow the window rather than the viewport) get a
// large-icon grid. Items are plain links, so everything works without
// JavaScript. An item with `body` instead of `href` is a text file that opens
// in place (<details>); one with neither is inert, e.g. a deleted file in the
// Recycle Bin.
import Icon from './Icon.astro';
import FolderTree from './explorer/FolderTree.astro';
import { getTree } from './explorer/tree';
import './explorer/explorer.css';

export interface ExplorerItem {
  label: string;
  icon: string;
  href?: string;
  /** Adds the download attribute (true, or a file name). */
  download?: boolean | string;
  /** Opens in a new tab and marks the link as external. */
  external?: boolean;
  /** Shown in the details view and as the link's description. */
  description?: string;
  /** Paragraphs of a text file shown in place when the item is opened. */
  body?: string[];
}

interface Props {
  /** Address bar text, e.g. "C:\\Joel Hunt\\Projects\\". */
  path: string;
  items?: ExplorerItem[];
  /** "icons": large icons (list on phones). "details": name + description rows. */
  view?: 'icons' | 'details';
  /** Accessible name for the file list. */
  label?: string;
  /** Small icon in the address bar. */
  icon?: string;
  /** Folders tree, Back and Forward. */
  nav?: boolean;
}

const { path, items = [], view = 'icons', label = 'Files', icon = 'folder-open', nav = false } = Astro.props;
const hasDetails = Astro.slots.has('details');
const hasDoc = Astro.slots.has('default');
const hasFiles = items.length > 0;
// Stable per folder, so builds are reproducible.
const uid = [...path].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7).toString(36);
// Same clean form the links use: /projects, not /projects.html.
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '$1').replace(/(.)\/+$/, '$1') || '/';
const tree = nav ? await getTree() : null;
const Root = nav ? 'win-explorer' : 'div';
---

<Root
  class:list={[
    'explorer',
    `explorer--${view}`,
    { 'explorer--nav': nav, 'explorer--with-details': hasDetails, 'explorer--home': hasDoc && hasFiles },
  ]}
>
  <div class="explorer-bar">
    {nav && (
      <div class="explorer-tools">
        <button type="button" class="explorer-tool" data-explorer="tree" aria-controls="explorer-tree" aria-expanded="true" aria-label="Folders" title="Folders">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h12v2H2zm0 4h12v2H2zm0 4h12v2H2z" /></svg>
        </button>
        <button type="button" class="explorer-tool" data-explorer="back" aria-label="Back" title="Back" disabled>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8l6-6v4h8v4H7v4z" /></svg>
        </button>
        <button type="button" class="explorer-tool" data-explorer="forward" aria-label="Forward" title="Forward" disabled>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M15 8L9 2v4H1v4h8v4z" /></svg>
        </button>
      </div>
    )}
    <div class="explorer-address">
      <span class="explorer-address-label" id={`addr-${uid}`}>Address</span>
      <div class="explorer-address-field" aria-labelledby={`addr-${uid}`}>
        <Icon name={icon} size={16} />
        <span>{path}</span>
      </div>
    </div>
  </div>

  <div class="explorer-main">
    {tree && (
      <nav class="explorer-tree" id="explorer-tree" aria-label="Folders">
        <FolderTree nodes={[tree]} current={current} />
      </nav>
    )}

    <div class="explorer-pane">
      <div class="explorer-view">
        {hasDoc && (
          <div class="explorer-doc doc">
            <slot />
          </div>
        )}

        {hasDetails && (
          <aside class="explorer-details doc" aria-label="Details">
            <slot name="details" />
          </aside>
        )}

        {hasFiles && (
          <ul class="explorer-files" aria-label={label}>
            {items.map((item, i) => {
              const descId = item.description ? `desc-${uid}-${i}` : undefined;
              return (
                <li class:list={['explorer-item', { 'explorer-item--text': item.body }]}>
                  {item.body ? (
                    <details class="explorer-textfile">
                      <summary class="explorer-link">
                        <Icon name={item.icon} size={32} />
                        <span class="explorer-label">{item.label}</span>
                      </summary>
                      <div class="explorer-notepad doc">
                        {item.body.map((p) => <p>{p}</p>)}
                      </div>
                    </details>
                  ) : item.href ? (
                    <a
                      class="explorer-link"
                      href={item.href}
                      download={item.download === true ? '' : item.download || undefined}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener' : undefined}
                      aria-describedby={descId}
                    >
                      <Icon name={item.icon} size={32} />
                      <span class="explorer-label">
                        {item.label}
                        {item.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                      </span>
                    </a>
                  ) : (
                    <div class="explorer-link explorer-link--inert">
                      <Icon name={item.icon} size={32} />
                      <span class="explorer-label">{item.label}</span>
                    </div>
                  )}
                  {item.description && (
                    <p class="explorer-desc" id={descId}>{item.description}</p>
                  )}
                </li>
              );
            })}
          </ul>
        )}
      </div>
    </div>
  </div>
</Root>

<script>
  import '../scripts/explorer';
</script>
